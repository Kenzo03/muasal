# Copy to deploy/.env and change both passwords.
VERSION=dev
# The origin users open. With HTTP_PORT other than 80, include the port, e.g. http://localhost:8080.
PUBLIC_URL=http://localhost
HTTP_PORT=80
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
# Seals AI API keys; needed only to save a key (BYOK). Generate with: openssl rand -base64 32
APP_SECRET_KEY=
# Days the Ask log keeps each question (FSD §15.4); 0 keeps them for good.
ASK_LOG_RETENTION_DAYS=365
